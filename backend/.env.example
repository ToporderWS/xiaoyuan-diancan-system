# ============================================================
# 《校园点餐管理系统》后端环境变量模板
# 使用方式：复制本文件为 .env 并按本机实际情况修改
#   copy .env.example .env      (Windows)
#   cp   .env.example .env      (macOS / Linux)
# 注意：.env 中包含敏感信息，禁止提交到版本库。
# ============================================================

# ---------- Flask ----------
FLASK_ENV=development
FLASK_DEBUG=1
# 对外服务端口（三端统一使用 5000）
SERVER_PORT=5000

# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=campus_order
DB_POOL_SIZE=16

# 测试专用库（pytest 使用，必须与业务库不同，避免误删真实数据）
TEST_DB_NAME=campus_order_test

# ---------- JWT ----------
# 生产环境请改为足够随机的长字符串
JWT_SECRET=change-me-please-a-very-long-random-secret-string
# 学生 Token 有效期（分钟）
JWT_STUDENT_EXPIRE_MINUTES=1440
# 管理员 Token 有效期（分钟）
JWT_ADMIN_EXPIRE_MINUTES=720

# ---------- 业务 ----------
# 未支付订单自动取消阈值（分钟）
ORDER_TIMEOUT_MINUTES=15
# 定时任务扫描间隔（秒）
SCHEDULER_SCAN_INTERVAL=60
# 是否开启定时任务（pytest 下自动关闭）
ENABLE_SCHEDULER=1

# ---------- 上传 ----------
# 单文件最大字节数（2MB）
MAX_UPLOAD_SIZE=2097152

# ---------- 对外访问基础地址（集中配置，前端同源对应） ----------
# 开发环境：填当前电脑的实际局域网 IP（用 ipconfig / ifconfig 查看）。
#   小程序模拟器 / 真机必须使用局域网 IP；127.0.0.1 只能被本机自身访问。
# 生产环境：这两个值换成 HTTPS 域名即可，业务代码无需改动。
# 小程序 / PC 后台访问的 API 基础地址
PUBLIC_API_BASE=http://192.168.0.103:5000/api
# 图片静态资源基础地址（结尾必须带 /）
PUBLIC_STATIC_BASE=http://192.168.0.103:5000/static/upload/
